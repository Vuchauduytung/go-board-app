@startuml go_scan_cloud_run
title Go Scan - Cloud Run Infrastructure

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

actor "Phone browser\n(Google account)" as user

package "Google Cloud project" {
  cloud "Identity-Aware Proxy\nonly allowed Google accounts" as iap

  package "Cloud Run - us-central1" {
    node "go-scan\n2 vCPU / 4 GiB / port 8000\nmin 0, max 1, concurrency 4\ngen2, timeout 180 s" as app {
      component "FastAPI + static web app\n/api/recognize /api/analyze\n/api/chat /api/books/.../pages" as api
      component "Moku RT-DETR (ONNX)\n+ image2sgf corners\nphoto -> board matrix" as recog
      component "multilingual-e5-small\nCPU embeddings, 384 d" as embedder
    }
    node "go-katago\n2 vCPU / 2 GiB / port 8080\nmin 0, max 1\nIAM: go-scan-run only" as katago {
      component "KataGo v1.16.4 Eigen AVX2\nb15c192 net, 200 visits" as engine
    }
  }

  database "Cloud Storage\n<project>-go-scan\nmounted at /data" as bucket
  cloud "Secret Manager\ncloud-bot Gemini, Qdrant,\nValkey secrets (shared)" as secrets
  cloud "Artifact Registry\nus-central1/go-scan" as registry
}

package "Shared with cloud-bot" {
  database "Qdrant Cloud\ncollection go_books_e5\n11 books, ~2,400 chunks" as qdrant
  database "Upstash Valkey\ngo-scan:session:*\ngo-scan:chat-daily:*" as valkey
  cloud "Gemini Developer API\ngemini-3.5-flash-lite\nfree tier, shared quota" as gemini
}

folder "Go books (PDF, EPUB)\n+ OCR of scanned PDFs" as books
component "Local ingestion\nrag.ingest_books" as ingestion

user --> iap : HTTPS
iap --> api : signed-in requests only
api --> recog : 1. photo
api --> bucket : 2. save photo / board (scans/)
api --> engine : 3. move suggestions\n(ID token)
api --> embedder : 4. question (+ English translation)
embedder --> qdrant : 5. vector search
api --> gemini : 6. translate query, answer with citations
api --> valkey : 7. history, rate limits
api --> bucket : 8. cited page images (books/pages/)

books --> ingestion
ingestion --> qdrant : upsert vectors
ingestion --> bucket : page images
secrets ..> app : runtime secret refs
registry ..> app
registry ..> katago

note bottom of app
  **Limits:**
  - Chat: 300 questions/day for the app, 5/min per user
  - Free tier vCPU/GiB-seconds shared with cloud-bot
  - Cold start ~10-20 s after idle
end note
@enduml
