# Copy to deploy/oracle/.env (not in git) and fill in. See deploy/oracle/README.md.

# --- Way in for users: duckdns (free, default) or cloudflare (own domain) ---
COMPOSE_PROFILES=duckdns
TRUST_FORWARDED_EMAIL=1
TRUST_CF_ACCESS=0
# duckdns: your <name>.duckdns.org, the Google OAuth client, a random cookie secret
DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32 | tr -- '+/' '-_'
COOKIE_SECRET=
# cloudflare instead: COMPOSE_PROFILES=cloudflare, TRUST_FORWARDED_EMAIL=0, TRUST_CF_ACCESS=1 and the tunnel token
CF_TUNNEL_TOKEN=

# --- AI: Gemini + Qdrant Cloud (same values as cloud-bot/.env) ---
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
# Optional fallback LLMs when Gemini is overloaded or out of free quota (see deploy/LLM_PROVIDERS.md)
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# --- KataGo on a Modal L4 GPU (katago/modal_katago.py); the Modal proxy token as in cloud-bot/.env ---
KATAGO_URL=https://vuchauduytung--go-katago-katago-serve.modal.run
KATAGO_AUTH=modal
KATAGO_MODAL_TOKEN=
# or on the VM's CPU (slow on 2 cores): add ",katago" to COMPOSE_PROFILES, KATAGO_URL=http://katago:8080, KATAGO_AUTH=

# --- Admin Telegram bot (telegram_bot.py, see deploy/README.md): token from @BotFather, a random secret
# (openssl rand -hex 32) and the admins' chat ids (comma-separated; /start shows yours). Empty = no bot. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=

# Admins: no usage limits (comma-separated)
ADMIN_EMAILS=vuchauduytung@gmail.com
# Photos, boards and review sessions on the VM
DATA_PATH=/srv/go-scan
